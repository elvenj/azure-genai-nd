# --- Azure OpenAI: Text Generation (e.g., West US) ---
AZURE_OPENAI_TEXT_ENDPOINT=https://<YOUR_TEXT_RESOURCE_NAME>.openai.azure.com/
AZURE_OPENAI_TEXT_KEY=<YOUR_TEXT_API_KEY>

# --- Azure OpenAI: Image Generation (e.g., East US 2) ---
AZURE_OPENAI_IMAGE_ENDPOINT=https://<YOUR_IMAGE_RESOURCE_NAME>.cognitiveservices.azure.com/
AZURE_OPENAI_IMAGE_KEY=<YOUR_IMAGE_API_KEY>
